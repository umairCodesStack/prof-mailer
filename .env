# --- SMTP (Gmail: enable 2-step verification, then create an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=umair.ashraf.codes@gmail.com
SMTP_PASSWORD=nydzvfqzkqymierz
FROM_NAME=Muhammad Umair Ashraf

# --- App behaviour ---
DRY_RUN=false                 # true = never really send, just log. Set false when ready.
DAILY_LIMIT=150              # max emails actually sent per day (app timezone)
APP_TIMEZONE=Asia/Karachi    # timezone used for times you enter without an offset
CHECK_INTERVAL_SECONDS=30    # how often the worker looks for due emails
API_KEY=change-me            # required in the X-API-Key header; leave empty to disable
DATABASE_URL=sqlite:///./data/mailer.db
DATA_DIR=./data
